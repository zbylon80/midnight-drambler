{
  "manifest_version": 2,
  "name": "Midnight Drambler",
  "version": "0.1.0",
  "description": "Lokalna blokada nocnego pisania na Facebooku i Messengerze.",
  "permissions": [
    "storage",
    "*://*.facebook.com/*",
    "*://*.messenger.com/*"
  ],
  "browser_action": {
    "default_title": "Midnight Drambler",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.messenger.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0"
    }
  }
}
